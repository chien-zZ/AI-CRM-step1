# Non-secret example only. Copy to a root-owned host configuration outside the repository,
# replace every example value after topology/capacity review, and never add Secret values.
AI_CRM_PUBLIC_HOST=crm.example.invalid
AI_CRM_PRIVATE_BIND_ADDRESS=10.0.0.10
AI_CRM_API_HOST_A=10.0.0.10
AI_CRM_API_PORT_A=3101
AI_CRM_API_HOST_B=10.0.0.11
AI_CRM_API_PORT_B=3102
AI_CRM_STATE_HOST=10.0.0.10
AI_CRM_SECRET_ROOT=/run/ai-crm-secrets/production
AI_CRM_APPLICATION_UID_GID=10001:10001
AI_CRM_EDGE_UID=101
AI_CRM_EDGE_GID=101
AI_CRM_KEYCLOAK_REALM=ai-crm
AI_CRM_FLOWABLE_ADMIN_REFERENCE=flowable-admin-reference
