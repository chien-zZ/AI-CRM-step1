upstream ai_crm_api {
  zone ai_crm_api 64k;
  server ${AI_CRM_API_HOST_A}:${AI_CRM_API_PORT_A} max_fails=2 fail_timeout=10s;
  server ${AI_CRM_API_HOST_B}:${AI_CRM_API_PORT_B} max_fails=2 fail_timeout=10s;
  keepalive 32;
}

log_format safe_technical '$time_iso8601 status=$status duration=$request_time request_id=$request_id';

server {
  listen 8080;
  server_name _;
  access_log off;
  location = /health/live {
    default_type application/json;
    return 200 '{"status":"ok"}';
  }
  location / { return 404; }
}

server {
  listen 8443 ssl;
  server_name ${AI_CRM_PUBLIC_HOST};
  server_tokens off;

  ssl_certificate /run/secrets/tls_certificate;
  ssl_certificate_key /run/secrets/tls_private_key;
  ssl_protocols TLSv1.2 TLSv1.3;

  access_log /dev/stdout safe_technical;
  error_log /dev/stderr warn;
  client_max_body_size 1m;

  location /api/ {
    proxy_pass http://ai_crm_api;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Request-Id $request_id;
    proxy_set_header Connection "";
  }

  location /bff/ {
    proxy_pass http://ai_crm_api;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Request-Id $request_id;
    proxy_set_header Connection "";
  }

  location /realms/ {
    proxy_pass http://${AI_CRM_KEYCLOAK_PRIVATE_HOST}:8080;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-For $remote_addr;
  }

  location /internal/ {
    try_files $uri $uri/ /internal/index.html;
  }

  location /external/ {
    try_files $uri $uri/ /external/index.html;
  }

  location / {
    try_files $uri $uri/ /index.html;
  }
}
