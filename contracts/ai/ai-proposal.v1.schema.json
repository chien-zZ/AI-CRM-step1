{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.ai-crm.local/ai/v1/ai-proposal.schema.json",
  "title": "Non-authoritative AI proposal V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "proposalId", "useCaseId", "outputSchemaVersion", "outputDigest", "expiresAt", "authoritative", "requiresHumanConfirmation", "output"],
  "properties": {
    "version": { "const": 1 },
    "proposalId": { "$ref": "#/$defs/uuid" },
    "useCaseId": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]{2,127}$" },
    "outputSchemaVersion": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_.:-]{0,127}$" },
    "outputDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "expiresAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$" },
    "authoritative": { "const": false },
    "requiresHumanConfirmation": { "const": true },
    "output": true
  },
  "$defs": { "uuid": { "type": "string", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$" } }
}
