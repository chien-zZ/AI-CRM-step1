{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.ai-crm.local/ai/v1/ai-call-record.schema.json",
  "title": "Safe AI call metadata V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "callId", "operationId", "useCaseId", "resourceReference", "status", "dataClassification", "inputDigest", "outputDigest", "tokenUsage", "costMicros", "proposalId", "traceId", "adapterVersion", "budgetPolicyVersion", "dataPolicyVersion", "inputSchemaVersion", "modelPolicyVersion", "outputSchemaVersion", "promptPolicyVersion"],
  "properties": {
    "version": { "const": 1 },
    "callId": { "$ref": "#/$defs/uuid" },
    "operationId": { "$ref": "#/$defs/uuid" },
    "useCaseId": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]{2,127}$" },
    "resourceReference": { "type": "string", "maxLength": 255 },
    "status": { "const": "proposal_created" },
    "dataClassification": { "const": "synthetic" },
    "inputDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "outputDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "tokenUsage": { "type": "object", "additionalProperties": false, "required": ["input", "output", "total"], "properties": { "input": { "type": "integer", "minimum": 0 }, "output": { "type": "integer", "minimum": 0 }, "total": { "type": "integer", "minimum": 0 } } },
    "costMicros": { "type": "integer", "minimum": 0 },
    "proposalId": { "$ref": "#/$defs/uuid" },
    "traceId": { "type": "string", "pattern": "^(?!0{32})[0-9a-f]{32}$" }
    ,"adapterVersion": { "$ref": "#/$defs/versionReference" }
    ,"budgetPolicyVersion": { "$ref": "#/$defs/versionReference" }
    ,"dataPolicyVersion": { "$ref": "#/$defs/versionReference" }
    ,"inputSchemaVersion": { "$ref": "#/$defs/versionReference" }
    ,"modelPolicyVersion": { "$ref": "#/$defs/versionReference" }
    ,"outputSchemaVersion": { "$ref": "#/$defs/versionReference" }
    ,"promptPolicyVersion": { "$ref": "#/$defs/versionReference" }
  },
  "$defs": {
    "uuid": { "type": "string", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$" },
    "versionReference": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_.:-]{0,127}$" }
  }
}
