{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.ai-crm.local/ai/v1/ai-proposal-confirmation.schema.json",
  "title": "AI proposal confirmation fact V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "confirmationId", "operationId", "proposalId", "useCaseId", "resourceReference", "actor", "decision", "confirmedAt", "traceId", "authoritative", "domainCommandExecuted"],
  "properties": {
    "version": { "const": 1 },
    "confirmationId": { "$ref": "#/$defs/uuid" },
    "operationId": { "$ref": "#/$defs/uuid" },
    "proposalId": { "$ref": "#/$defs/uuid" },
    "useCaseId": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]{2,127}$" },
    "resourceReference": { "type": "string", "pattern": "^[A-Za-z0-9_.:@/-]{1,255}$" },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actorId", "actorType"],
      "properties": {
        "actorId": { "type": "string", "pattern": "^[A-Za-z0-9_.:@/-]{1,255}$" },
        "actorType": { "const": "authenticated_subject" },
        "assignmentId": { "$ref": "#/$defs/uuid" },
        "workforcePersonId": { "$ref": "#/$defs/uuid" }
      }
    },
    "decision": { "enum": ["accepted", "modified", "rejected"] },
    "reason": { "type": "string", "minLength": 1, "maxLength": 500 },
    "confirmedAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$" },
    "traceId": { "type": "string", "pattern": "^(?!0{32})[0-9a-f]{32}$" },
    "authoritative": { "const": false },
    "domainCommandExecuted": { "const": false }
  },
  "$defs": {
    "uuid": { "type": "string", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$" }
  }
}
