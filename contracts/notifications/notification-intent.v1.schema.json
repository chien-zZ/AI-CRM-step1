{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-crm.local/contracts/notifications/v1/notification-intent.schema.json",
  "title": "Notification Intent v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["intentId","producer","idempotencyKey","templateKey","templateVersion","selectors","variables","sourceType","sourceId","deepLink"],
  "properties": {
    "intentId": { "type": "string", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$" },
    "producer": { "$ref": "#/$defs/stableId" },
    "idempotencyKey": { "$ref": "#/$defs/stableId" },
    "templateKey": { "$ref": "#/$defs/stableId" },
    "templateVersion": { "type": "integer", "minimum": 1 },
    "selectors": { "type": "array", "minItems": 1, "maxItems": 100, "items": { "$ref": "#/$defs/recipientSelector" } },
    "variables": { "type": "object" },
    "sourceType": { "$ref": "#/$defs/stableId" },
    "sourceId": { "$ref": "#/$defs/stableId" },
    "deepLink": { "$ref": "#/$defs/deepLink" }
  },
  "$defs": {
    "stableId": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,254}$" },
    "recipientSelector": { "type": "object", "additionalProperties": false, "required": ["selectorType","referenceId"], "properties": { "selectorType": { "$ref": "#/$defs/stableId" }, "referenceId": { "$ref": "#/$defs/stableId" } } },
    "deepLink": { "type": "object", "additionalProperties": false, "required": ["applicationId","routeId","resourceType","resourceId"], "properties": { "applicationId": { "$ref": "#/$defs/stableId" }, "routeId": { "$ref": "#/$defs/stableId" }, "resourceType": { "$ref": "#/$defs/stableId" }, "resourceId": { "$ref": "#/$defs/stableId" }, "parameters": { "type": "object", "maxProperties": 20, "additionalProperties": { "$ref": "#/$defs/stableId" }, "propertyNames": { "$ref": "#/$defs/stableId" } } } }
  }
}
