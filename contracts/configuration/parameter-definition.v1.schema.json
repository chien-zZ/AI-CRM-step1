{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.ai-crm.local/configuration/v1/parameter-definition.schema.json",
  "title": "Typed Parameter Definition V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["definitionVersion", "parameterKey", "ownerModule", "valueType", "valueSchema", "allowedScopes", "missingPolicy"],
  "properties": {
    "definitionVersion": { "const": 1 },
    "parameterKey": { "$ref": "#/$defs/id" },
    "ownerModule": { "$ref": "#/$defs/id" },
    "valueType": { "enum": ["boolean", "integer", "number", "string"] },
    "valueSchema": { "type": "object" },
    "allowedScopes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scopeType", "priority"],
        "properties": {
          "scopeType": { "$ref": "#/$defs/id" },
          "priority": { "type": "integer", "minimum": 0, "maximum": 1000, "description": "Higher numeric priority wins when more than one supplied scope has an effective activation." }
        }
      }
    },
    "missingPolicy": { "enum": ["fail_closed", "use_default"] },
    "defaultValue": { "$ref": "#/$defs/value" }
  },
  "allOf": [
    { "if": { "properties": { "missingPolicy": { "const": "use_default" } } }, "then": { "properties": { "defaultValue": { "$ref": "#/$defs/value" } }, "required": ["defaultValue"] } },
    { "if": { "properties": { "missingPolicy": { "const": "fail_closed" } } }, "then": { "properties": { "defaultValue": false } } }
  ],
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,127}$" },
    "value": { "anyOf": [{ "type": "string" }, { "type": "number" }, { "type": "boolean" }] }
  }
}
