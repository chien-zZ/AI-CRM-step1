{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.ai-crm.local/audit/v1/audit-record.schema.json",
  "title": "Audit Record V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "auditId", "occurredAt", "actor", "action", "resource", "result", "reason", "trace"],
  "properties": {
    "version": { "const": 1 },
    "auditId": { "$ref": "#/$defs/uuid" },
    "occurredAt": { "$ref": "#/$defs/instant" },
    "actor": {
      "type": "object", "additionalProperties": false, "required": ["actorId", "actorType"],
      "properties": {
        "actorId": { "type": "string", "minLength": 1, "maxLength": 255 },
        "actorType": { "enum": ["authenticated_subject", "system"] },
        "workforcePersonId": { "$ref": "#/$defs/uuid" },
        "assignmentId": { "$ref": "#/$defs/uuid" }
      }
    },
    "action": { "$ref": "#/$defs/code" },
    "resource": {
      "type": "object", "additionalProperties": false, "required": ["resourceId", "resourceType"],
      "properties": { "resourceId": { "type": "string", "minLength": 1, "maxLength": 255 }, "resourceType": { "$ref": "#/$defs/code" } }
    },
    "result": { "enum": ["attempted", "succeeded", "failed", "denied"] },
    "reason": {
      "type": "object", "additionalProperties": false, "required": ["code"],
      "properties": { "code": { "$ref": "#/$defs/code" }, "detail": { "type": "string", "minLength": 1, "maxLength": 500 } }
    },
    "trace": {
      "type": "object", "additionalProperties": false, "required": ["traceId", "operationId"],
      "properties": {
        "traceId": { "type": "string", "pattern": "^(?!0{32})[0-9a-f]{32}$" },
        "operationId": { "$ref": "#/$defs/uuid" },
        "authorizationDecisionId": { "$ref": "#/$defs/uuid" }
      }
    },
    "changes": {
      "type": "array", "maxItems": 100, "items": {
        "oneOf": [
          { "type": "object", "additionalProperties": false, "required": ["field", "classification"], "properties": { "field": { "$ref": "#/$defs/code" }, "classification": { "const": "non_sensitive" }, "before": { "$ref": "#/$defs/scalar" }, "after": { "$ref": "#/$defs/scalar" } } },
          { "type": "object", "additionalProperties": false, "required": ["field", "classification", "changed"], "properties": { "field": { "$ref": "#/$defs/code" }, "classification": { "const": "sensitive" }, "changed": { "const": true } } }
        ]
      }
    }
  },
  "$defs": {
    "code": { "type": "string", "pattern": "^[a-z][a-z0-9_.:-]{0,127}$" },
    "uuid": { "type": "string", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$" },
    "instant": { "type": "string", "maxLength": 24, "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$" },
    "scalar": { "oneOf": [{ "type": "string", "maxLength": 500 }, { "type": "number" }, { "type": "boolean" }, { "type": "null" }] }
  }
}
