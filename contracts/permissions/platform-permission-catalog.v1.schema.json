{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.ai-crm.local/permissions/v1/platform-permission-catalog.schema.json",
  "title": "Platform Permission Catalog",
  "description": "Business-neutral permission declarations owned by platform modules. Role bundles and effective grants are intentionally outside this catalog.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "permissions"],
  "properties": {
    "version": { "const": 1 },
    "permissions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/permission" }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$"
    },
    "action": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "permissionCode": {
      "type": "string",
      "minLength": 5,
      "maxLength": 193,
      "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+:[a-z][a-z0-9-]*$"
    },
    "permission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "code", "resource", "action", "scopeDimensions"],
      "properties": {
        "owner": { "$ref": "#/$defs/identifier" },
        "code": { "$ref": "#/$defs/permissionCode" },
        "resource": { "$ref": "#/$defs/identifier" },
        "action": { "$ref": "#/$defs/action" },
        "scopeDimensions": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        }
      }
    }
  }
}
