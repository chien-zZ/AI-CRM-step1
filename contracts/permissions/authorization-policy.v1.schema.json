{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.ai-crm.local/permissions/v1/authorization-policy.schema.json",
  "title": "Authorization Policy Snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "permissions", "roles", "grants"],
  "properties": {
    "version": { "$ref": "#/$defs/policyVersion" },
    "permissions": {
      "type": "array",
      "maxItems": 10000,
      "items": { "$ref": "#/$defs/permission" }
    },
    "roles": {
      "type": "array",
      "maxItems": 10000,
      "items": { "$ref": "#/$defs/role" }
    },
    "grants": {
      "type": "array",
      "maxItems": 100000,
      "items": { "$ref": "#/$defs/grant" }
    }
  },
  "$defs": {
    "uuid": { "type": "string", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$" },
    "timestamp": {
      "type": "string",
      "maxLength": 24,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "identifier": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$"
    },
    "action": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "permissionCode": {
      "type": "string",
      "minLength": 5,
      "maxLength": 193,
      "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+:[a-z][a-z0-9-]*$"
    },
    "policyVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "permission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "resource", "action", "scopeDimensions"],
      "properties": {
        "code": { "$ref": "#/$defs/permissionCode" },
        "resource": { "$ref": "#/$defs/identifier" },
        "action": { "$ref": "#/$defs/action" },
        "scopeDimensions": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "terms"],
      "properties": {
        "version": { "const": 1 },
        "terms": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind"],
                "properties": { "kind": { "const": "all" } }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "constraints"],
                "properties": {
                  "kind": { "const": "match" },
                  "constraints": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 32,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["dimension", "values"],
                      "properties": {
                        "dimension": { "$ref": "#/$defs/identifier" },
                        "values": {
                          "type": "array",
                          "minItems": 1,
                          "maxItems": 256,
                          "uniqueItems": true,
                          "items": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 255,
                            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,254}$"
                          }
                        }
                      }
                    }
                  }
                }
              }
            ]
          }
        }
      }
    },
    "role": {
      "type": "object",
      "additionalProperties": false,
      "required": ["roleId", "permissions"],
      "properties": {
        "roleId": { "$ref": "#/$defs/uuid" },
        "permissions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["permissionCode", "scope"],
            "properties": {
              "permissionCode": { "$ref": "#/$defs/permissionCode" },
              "scope": { "$ref": "#/$defs/scope" }
            }
          }
        }
      }
    },
    "grant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["grantId", "roleId", "subject", "validFrom"],
      "properties": {
        "grantId": { "$ref": "#/$defs/uuid" },
        "roleId": { "$ref": "#/$defs/uuid" },
        "subject": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "workforcePersonId"],
              "properties": {
                "kind": { "const": "workforce_person" },
                "workforcePersonId": { "$ref": "#/$defs/uuid" }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "assignmentId"],
              "properties": {
                "kind": { "const": "assignment" },
                "assignmentId": { "$ref": "#/$defs/uuid" }
              }
            }
          ]
        },
        "validFrom": { "$ref": "#/$defs/timestamp" },
        "validTo": { "$ref": "#/$defs/timestamp" }
      }
    }
  }
}
