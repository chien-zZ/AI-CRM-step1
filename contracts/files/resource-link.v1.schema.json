{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.ai-crm.local/files/v1/resource-link.schema.json",
  "title": "File Resource Link V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "linkId", "fileId", "contentVersionId", "ownerModule", "resource", "relationType", "linkedAt"],
  "properties": {
    "version": { "const": 1 }, "linkId": { "$ref": "#/$defs/uuid" }, "fileId": { "$ref": "#/$defs/uuid" }, "contentVersionId": { "$ref": "#/$defs/uuid" },
    "ownerModule": { "$ref": "#/$defs/id" }, "relationType": { "$ref": "#/$defs/id" }, "linkedAt": { "$ref": "#/$defs/dateTime" }, "unlinkedAt": { "$ref": "#/$defs/dateTime" },
    "resource": { "type": "object", "additionalProperties": false, "required": ["resourceType", "resourceId"], "properties": { "resourceType": { "$ref": "#/$defs/id" }, "resourceId": { "type": "string", "minLength": 1, "maxLength": 255, "pattern": "^[A-Za-z0-9_.:@/-]+$" } } }
  },
  "$defs": { "uuid": { "type": "string", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$" }, "id": { "type": "string", "pattern": "^[a-z][a-z0-9_.:-]{1,127}$" }, "dateTime": { "type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[0-1])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$" } }
}
