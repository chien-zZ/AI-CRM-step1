{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.ai-crm.local/files/v1/transfer-grant.schema.json",
  "title": "Short-lived File Transfer Grant V1",
  "oneOf": [
    { "type": "object", "additionalProperties": false, "required": ["version", "method", "uploadUrl", "expiresAt", "headers"], "properties": { "version": { "const": 1 }, "method": { "const": "PUT" }, "uploadUrl": { "type": "string", "maxLength": 2048, "pattern": "^https?://[^\\s]+$" }, "expiresAt": { "$ref": "#/$defs/dateTime" }, "headers": { "type": "object", "maxProperties": 20, "additionalProperties": { "type": "string", "maxLength": 1024 } } } },
    { "type": "object", "additionalProperties": false, "required": ["version", "downloadUrl", "expiresAt", "fileReference"], "properties": { "version": { "const": 1 }, "downloadUrl": { "type": "string", "maxLength": 2048, "pattern": "^https?://[^\\s]+$" }, "expiresAt": { "$ref": "#/$defs/dateTime" }, "fileReference": { "$ref": "#/$defs/fileReference" } } }
  ],
  "$defs": {
    "dateTime": { "type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[0-1])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$" },
    "uuid": { "type": "string", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$" },
    "fileReference": { "type": "object", "additionalProperties": false, "required": ["version", "fileId", "contentVersionId", "displayName"], "properties": { "version": { "const": 1 }, "fileId": { "$ref": "#/$defs/uuid" }, "contentVersionId": { "$ref": "#/$defs/uuid" }, "displayName": { "type": "string", "minLength": 1, "maxLength": 255 }, "mediaType": { "type": "string", "minLength": 3, "maxLength": 255 }, "sizeBytes": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 } } }
  }
}
