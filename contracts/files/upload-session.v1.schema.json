{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.ai-crm.local/files/v1/upload-session.schema.json",
  "title": "Upload Session V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "sessionId", "fileId", "contentVersionId", "status", "createdAt", "expiresAt"],
  "properties": {
    "version": { "const": 1 },
    "sessionId": { "$ref": "#/$defs/uuid" }, "fileId": { "$ref": "#/$defs/uuid" }, "contentVersionId": { "$ref": "#/$defs/uuid" },
    "status": { "enum": ["created", "pending_scan", "expired", "cleanup_pending", "cleaned"] },
    "createdAt": { "$ref": "#/$defs/dateTime" }, "expiresAt": { "$ref": "#/$defs/dateTime" }
  },
  "$defs": { "uuid": { "type": "string", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$" }, "dateTime": { "type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[0-1])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$" } }
}
