{
  "name": "@ai-crm/platform-file-center",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./provider/tencent-cos": "./dist/tencent-cos-storage-adapter.js",
    "./testing/storage-adapter-conformance": "./dist/storage-adapter.conformance.js"
  },
  "scripts": {
    "build": "tsc -b",
    "lint": "eslint src --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json --noEmit --composite false",
    "test": "vitest run --config ../../../vitest.config.ts",
    "test:integration": "node scripts/run-integration.mjs",
    "contracts:check": "node ../../../scripts/check/verify-package.mjs",
    "migrate": "node dist/migrate.js"
  },
  "dependencies": {
    "@ai-crm/database": "workspace:*",
    "cos-nodejs-sdk-v5": "2.15.4",
    "drizzle-orm": "0.45.2"
  }
}
