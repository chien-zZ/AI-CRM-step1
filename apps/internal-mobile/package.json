{
  "name": "@ai-crm/internal-mobile",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": { ".": "./dist/index.js" },
  "scripts": {
    "dev": "cross-env NODE_ENV=development INTERNAL_MOBILE_RUNTIME=development taro build --type h5 --watch",
    "build": "cross-env NODE_ENV=production INTERNAL_MOBILE_RUNTIME=production taro build --type h5 && node scripts/check-bundle.mjs",
    "bundle:check": "node scripts/check-bundle.mjs",
    "lint": "eslint src config scripts vitest.config.ts --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json --noEmit --composite false",
    "test": "node --test scripts/*.test.mjs && vitest run --config vitest.config.ts",
    "contracts:check": "node ../../scripts/check/verify-package.mjs"
  },
  "dependencies": {
    "@ai-crm/api-client": "workspace:*",
    "@nutui/nutui-react-taro": "3.0.20",
    "@tarojs/components": "4.2.1",
    "@tarojs/react": "4.2.1",
    "@tarojs/runtime": "4.2.1",
    "@tarojs/shared": "4.2.1",
    "@tarojs/taro": "4.2.1",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@babel/core": "7.28.4",
    "@babel/preset-react": "7.28.5",
    "@eslint/js": "9.32.0",
    "@tarojs/cli": "4.2.1",
    "@tarojs/plugin-framework-react": "4.2.1",
    "@tarojs/plugin-platform-h5": "4.2.1",
    "@tarojs/webpack5-runner": "4.2.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "babel-preset-taro": "4.2.1",
    "cross-env": "10.0.0",
    "jsdom": "27.1.0",
    "less": "4.2.2",
    "react-refresh": "0.14.2",
    "eslint": "9.32.0",
    "typescript": "5.8.3",
    "typescript-eslint": "8.38.0",
    "vitest": "3.2.4",
    "webpack": "5.91.0"
  }
}
