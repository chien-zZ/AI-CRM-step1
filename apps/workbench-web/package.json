{
  "name": "@ai-crm/workbench-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": { ".": "./dist/index.js" },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/check-bundle.mjs",
    "bundle:check": "node scripts/check-bundle.mjs",
    "preview": "vite preview",
    "lint": "eslint src --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json --noEmit --composite false",
    "test": "vitest run --config vitest.config.ts",
    "contracts:check": "node ../../scripts/check/verify-package.mjs"
  },
  "dependencies": {
    "@ant-design/icons": "6.3.2",
    "@ant-design/pro-components": "3.1.14-2",
    "@tanstack/react-query": "5.101.2",
    "antd": "6.5.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-router-dom": "7.9.5"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.0.4",
    "jsdom": "27.1.0",
    "vite": "7.1.12"
  }
}
